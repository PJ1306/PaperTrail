# Copy this file to .env and replace the placeholder with your own key.
# Never commit .env or share the real key in chat.

NEBIUS_API_KEY=your_nebius_api_key_here

# Optional. Documented default is NVIDIA Nemotron 3.5 Lightning.
# Confirm the exact ID in the Token Factory console before relying on it.
NEBIUS_MODEL_ID=nvidia/Nemotron-3_5-Lightning

# Optional. Official OpenAI-compatible Token Factory endpoint.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Optional. Maximum file size in megabytes per uploaded PDF (default: 20)
MAX_PDF_SIZE_MB=20

